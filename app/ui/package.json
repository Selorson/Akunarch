    "@types/node": "^22.13.0",
    "@types/three": "^0.178.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "ws": "^8.18.1"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.4.19",
    "@sparkjsdev/spark": "^0.1.10",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "three": "^0.178.0"
